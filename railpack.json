{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "java": "temurin-25",
    "dotnet": "8.0"
  },
  "deploy": {
    "aptPackages": ["...", "curl", "wget", "libicu-dev", "fontconfig", "libseccomp2"],
    "variables": {
      "JOBTOLOGY_AUTH_ENABLED": "false",
      "JOBTOLOGY_GUEST_SESSIONS_ENABLED": "false",
      "JOBTOLOGY_PRODUCT_ROLES_ENABLED": "true",
      "JOBTOLOGY_PRODUCT_ROLE_ARTIFACT_APPROVAL_PATH": "/app/config/product_roles/approvals/e0694fb99d45a2883e4e7dc75cbb4a7c01fe8ef8474054574b7c03aa22b191f5.json",
      "JOBTOLOGY_INPROCESS_WORKER_ENABLED": "true",
      "JOBTOLOGY_CAPABILITY_LIST_AUTHORITATIVE": "true"
    },
    "startCommand": "mise exec -- uvicorn jobtology_be.main:app --host 0.0.0.0 --port ${PORT:-8000}"
  }
}
