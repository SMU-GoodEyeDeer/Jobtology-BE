JOBTOLOGY_ENVIRONMENT=development
JOBTOLOGY_ENABLE_FIXTURES=false
JOBTOLOGY_ENABLE_FE_MOCK_SAMPLES=false
JOBTOLOGY_CORS_ORIGINS=["http://localhost:5173"]
JOBTOLOGY_AUTH_ENABLED=false
JOBTOLOGY_SESSION_TTL_SECONDS=604800

# Application PostgreSQL. Required in production and for persisted analysis or worker runs.
# JOBTOLOGY_DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/jobtology
# JOBTOLOGY_CORPUS_SNAPSHOT_PATH=./published-corpus.json
# JOBTOLOGY_WORKER_BATCH_LIMIT=1

# Corpus source defaults to the local published JSON snapshot. The Neo4j option exposes only the
# bounded read-only /api/v2 catalog; it does not enable editorial analysis or route planning.
JOBTOLOGY_CORPUS_SOURCE=local_json

# Neo4j Query API connection metadata. Set these only in the server environment when selecting
# neo4j_query_api; keep credentials out of version control and client-facing configuration.
# JOBTOLOGY_DB_LINK=graph.example.test:7687
# JOBTOLOGY_DB_PASSWORD=replace-me
# JOBTOLOGY_DB_PROTOCOL=bolt+s://

# Google OAuth is deferred. Keep authentication disabled; these are future setup placeholders.
# JOBTOLOGY_GOOGLE_CLIENT_ID=your-google-client-id
# JOBTOLOGY_GOOGLE_CLIENT_SECRET=your-google-client-secret
# JOBTOLOGY_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# JOBTOLOGY_FRONTEND_URL=http://localhost:5173
